# DosisAlerta — plantilla de variables de entorno
# COPIAR a .env y completar con valores reales. NUNCA subir .env a Git.
# Este archivo NO contiene credenciales reales: solo nombres y ejemplos.
# Se carga con python-dotenv en backend/app/core/config.py (Fase 1).

# --- Base de datos (PostgreSQL, ver docker-compose.yml) ---
# Formato SQLAlchemy async (asyncpg). La URL sin driver se construye
# en la configuración a partir de estas piezas, para no duplicarla.
POSTGRES_DB=dosisalerta
POSTGRES_USER=dosisalerta
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA_EN_LOCAL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Ejemplo completo, por si se prefiere una sola variable:
# DATABASE_URL=postgresql+asyncpg://dosisalerta:CAMBIA_ESTA_CONTRASENA_EN_LOCAL@localhost:5432/dosisalerta

# --- Backend (FastAPI) ---
# Secreto para firmar JWT. En desarrollo: una cadena larga aleatoria.
# Generarlo fuera del repo; nunca escribirlo en el código.
JWT_SECRET=CAMBIA_ESTE_SECRETO_JWT_POR_UNO_LARGO_Y_ALEATORIO
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7

# --- Bot de Telegram ---
# Se obtiene con @BotFather. NO se escribe en el código ni en la documentación.
TELEGRAM_BOT_TOKEN=PEGAR_AQUI_EL_TOKEN_DE_BOTFATHER_SIN_COMILLAS
TELEGRAM_BOT_USERNAME=dosisalerta_bot
# Secreto dedicado para el HMAC de los códigos de vinculación.
# Distinto de JWT_SECRET y del token del bot. Generarlo fuera del repo.
TELEGRAM_LINK_SECRET=CAMBIA_ESTE_SECRETO_DE_VINCULACION_POR_UNO_LARGO_Y_ALEATORIO

# --- Frontend (Vite) ---
# URL pública del backend. En desarrollo local coincide con el puerto 8000.
VITE_API_URL=http://localhost:8000/api/v1
