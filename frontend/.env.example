# DosisAlerta — frontend (Vite)
# Copiar a .env dentro de la carpeta frontend/ para desarrollo local.
# Vite solo lee variables que empiezan por VITE_ y solo desde la
# carpeta frontend/, no desde la raiz del proyecto. Por eso este
# archivo existe aqui, ademas del .env.example de la raiz (que es
# para backend y Docker). No contiene secretos: solo una URL local.
#
# VITE_API_URL es la UNICA variable del frontend y solo se configura
# aqui: el .env de la raiz NO la necesita (antes estaba duplicada
# alli y Vite la ignoraba). Debe coincidir con el backend: por
# defecto HOST 127.0.0.1 y PORT 8000, es decir, la URL de abajo.
# Si PORT cambia en el .env de la raiz, cambiar esta URL tambien.

VITE_API_URL=http://localhost:8000/api/v1
