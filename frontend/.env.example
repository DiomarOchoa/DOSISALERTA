# DosisAlerta — frontend (Vite)
# Copiar a .env dentro de la carpeta frontend/ para desarrollo local.
# Vite solo lee variables que empiezan por VITE_ y solo desde la
# carpeta frontend/, no desde la raiz del proyecto. Por eso este
# archivo existe aqui, ademas del .env.example de la raiz (que es
# para backend y Docker). No contiene secretos: solo una URL local.

VITE_API_URL=http://localhost:8000/api/v1
