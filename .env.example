# DosisAlerta — plantilla de variables de entorno (Fase C)
# COPIAR a .env y completar con valores reales. NUNCA subir .env a Git.
# Este archivo NO contiene credenciales reales: solo nombres y ejemplos.
#
# Dos tipos de variables:
# - IMPLEMENTADAS: el backend las lee hoy (backend/app/core/config.py
#   o backend/alembic/env.py). Sin ellas se usan los defectos indicados.
# - RESERVADAS: documentadas para una fase futura, el backend NO las
#   lee todavia. No aparentan funcionalidades que no existen.
#
# El frontend NO lee este archivo: Vite solo lee frontend/.env
# (ver frontend/.env.example). No duplicar variables del frontend aqui.

# --- Backend (FastAPI) — IMPLEMENTADAS ---
# Host y puerto del servidor (uvicorn). El puerto se valida: debe ser
# un entero entre 1 y 65535; si no lo es, el backend no arranca.
HOST=127.0.0.1
PORT=8000
# true/false (tambien 1/yes). En desarrollo, dejar en false.
DEBUG=false
# Origenes permitidos por CORS, separados por comas. En desarrollo,
# solo el frontend local de Vite (puerto 5173).
CORS_ORIGINS=http://localhost:5173

# --- Base de datos (PostgreSQL, ver docker-compose.yml) — IMPLEMENTADAS ---
# Dos formas de configurar la conexion, en este orden de prioridad:
# 1. DATABASE_URL (despliegues como Render): URL completa. Los esquemas
#    postgres:// y postgresql:// se normalizan automaticamente a
#    postgresql+asyncpg://; postgresql+asyncpg:// se usa tal cual. Los
#    parametros de la URL (por ejemplo sslmode) se conservan. Ejemplo
#    SIN credenciales reales (usuario y contrasena de ejemplo):
#    DATABASE_URL=postgresql://usuario:contrasena@host:5432/dosisalerta
# 2. Las cinco piezas POSTGRES_* (desarrollo local): la configuracion
#    construye la URL async (postgresql+asyncpg) a partir de ellas.
#    Sin DATABASE_URL se usan estas, como hasta ahora.
# Si DATABASE_URL esta definida pero no es valida (esquema no admitido
# o sin host), el backend no arranca: falla con un error claro en lugar
# de conectar en silencio a otro sitio.
POSTGRES_DB=dosisalerta
POSTGRES_USER=dosisalerta
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA_EN_LOCAL
POSTGRES_HOST=localhost
# Puerto del host (5432 por defecto). Si el 5432 esta ocupado en el PC
# (en el PC del equipo lo ocupa un PostgreSQL 18 nativo), usar 5433.
# Ver docker/README.md. El backend usa este mismo valor.
POSTGRES_PORT=5432

# --- Migraciones y pruebas (Alembic) — IMPLEMENTADA, solo para pruebas ---
# ALEMBIC_DATABASE_URL es un override opcional: si esta definida,
# Alembic migra contra esa URL en lugar de la de .env. La usan las
# pruebas de la Fase 2 para apuntar a la base aislada dosisalerta_test;
# las pruebas la ponen y la quitan solas. NO poner aqui la URL de la
# base de desarrollo ni usarla para el trabajo diario.
# ALEMBIC_DATABASE_URL=postgresql+asyncpg://dosisalerta:CAMBIA_ESTA_CONTRASENA_EN_LOCAL@localhost:5432/dosisalerta_test

# --- Autenticacion JWT — IMPLEMENTADAS (Fase 3) ---
# El backend las lee desde la Fase 3 (ver backend/app/core/config.py).
# JWT_SECRET es obligatorio y debe tener al menos 32 caracteres.
# Secreto para firmar JWT. En desarrollo: una cadena larga aleatoria.
# Generarlo fuera del repo; nunca escribirlo en el código ni
# compartirlo. Cada PC tiene su propio secreto.
JWT_SECRET=CAMBIA_ESTE_SECRETO_JWT_POR_UNO_LARGO_Y_ALEATORIO
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7

# --- Cuidadores — IMPLEMENTADA (Etapa 5) ---
# El backend la lee desde la Etapa 5 (ver backend/app/core/config.py).
# CAREGIVER_LINK_SECRET es obligatorio y debe tener al menos 32 caracteres.
# Secreto dedicado para el HMAC-SHA256 de los codigos de invitacion de
# cuidadores (RF20). Distinto de JWT_SECRET y de TELEGRAM_LINK_SECRET.
# Generarlo fuera del repo; nunca escribirlo en el codigo ni compartirlo.
CAREGIVER_LINK_SECRET=CAMBIA_ESTE_SECRETO_DE_CUIDADORES_POR_UNO_LARGO_Y_ALEATORIO

# --- Bot de Telegram — RESERVADA (Fase 6; demostracion local sin publicar) ---
# El backend principal NO lee estas variables. Solo las lee la
# demostracion local del bot (sin publicar, fuera del entorno comun).
# Se obtiene el token con @BotFather. NO se escribe en el código
# ni en la documentación.
TELEGRAM_BOT_TOKEN=PEGAR_AQUI_EL_TOKEN_DE_BOTFATHER_SIN_COMILLAS
# Nombre publico del bot (sin @).
TELEGRAM_BOT_USERNAME=DosisAlertaBot
# Secreto dedicado para el HMAC de los códigos de vinculación.
# Distinto de JWT_SECRET y del token del bot. Generarlo fuera del repo.
TELEGRAM_LINK_SECRET=CAMBIA_ESTE_SECRETO_DE_VINCULACION_POR_UNO_LARGO_Y_ALEATORIO
